{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "*": "allow",
      "shared/constants.js": "ask",
      "shared/physics.js": "ask",
      "shared/wigner.js": "ask",
      "tests/vectors.json": "ask",
      "data/**": "ask"
    },
    "bash": {
      "*": "allow",
      "rm *": "deny",
      "git reset --hard*": "deny",
      "python3 -c *": "deny",
      "node -e *": "deny",
      "sed -i*": "deny",
      "git push *": "ask",
      "npm install*": "ask"
    }
  }
}
